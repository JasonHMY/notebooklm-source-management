# Copy this file to .env and fill it locally.
# Do not commit .env or tokens.json.

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:3000/callback
X_OAUTH_SCOPES=tweet.read users.read tweet.write offline.access

# Optional: paste generated OAuth 2.0 tokens here, then run `node x-auth.js import`.
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=
